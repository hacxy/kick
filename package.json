{
  "name": "@hacxy/kick",
  "version": "0.8.0",
  "type": "module",
  "description": "A project scaffolding CLI tool",
  "author": {
    "name": "Hacxy",
    "email": "hacxy.js@outlook.com",
    "url": "https://hacxy.cn"
  },
  "license": "MIT",
  "keywords": [
    "cli",
    "scaffold",
    "kick",
    "template"
  ],
  "bin": {
    "kick": "cli/index.js"
  },
  "files": [
    "cli",
    "templates"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cli:dev": "cd cli && tsdown --watch",
    "cli:build": "cd cli && tsdown index.ts --minify",
    "cli:test": "cd cli && vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "chalk": "^6.0.0",
    "degit": "^3.6.6",
    "inquirer": "^14.0.2",
    "lucide-react": "^1.28.0",
    "ora": "^9.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@hacxy/eslint-config": "workspace:*",
    "@hacxy/prettier-config": "workspace:*",
    "@hacxy/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/degit": "^2.8.6",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.32.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "tsdown": "^0.13.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
