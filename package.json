{
  "name": "@hacxy/kick",
  "version": "0.12.0",
  "type": "module",
  "description": "A project scaffolding CLI tool",
  "author": {
    "name": "Hacxy",
    "email": "hacxy.js@outlook.com",
    "url": "https://hacxy.cn"
  },
  "license": "MIT",
  "keywords": [
    "cli",
    "scaffold",
    "kick",
    "template"
  ],
  "bin": {
    "kick": "bin/index.js"
  },
  "files": [
    "bin",
    "templates",
    "!templates/**/node_modules",
    "!templates/**/dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "release": "./scripts/release.sh",
    "prepare": "husky",
    "gen:templates": "npx tsx scripts/gen-templates.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "inquirer": "^14.0.2",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@hacxy/eslint-config": "workspace:*",
    "@hacxy/prettier-config": "workspace:*",
    "@hacxy/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.32.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "lucide-react": "^1.28.0",
    "prettier": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hacxy/kick.git"
  }
}
