{
  "name": "@hacxy/tpl-pi-extension",
  "version": "0.0.0",
  "description": "A Pi extension project",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "ai",
    "agents",
    "cli"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "dev": "pi -e ./src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "typebox": "^1.3.8"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@hacxy/eslint-config": "workspace:*",
    "@hacxy/prettier-config": "workspace:*",
    "@hacxy/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
